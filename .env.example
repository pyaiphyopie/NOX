# Root environment variables for local development
NODE_ENV=development
DATABASE_URL=postgresql://nox:noxpass@localhost:5432/nox
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-secure-random-value
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d
SUPABASE_URL=https://your-supabase-instance-url
SUPABASE_ANON_KEY=replace-with-supabase-key
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
