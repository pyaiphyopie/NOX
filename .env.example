# NOX Platform Environment Template
# Copy to .env and fill values

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# JWT
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# Payment Providers (Myanmar)
KBZPAY_MERCHANT_ID=
KBZPAY_API_KEY=
WAVEPAY_MERCHANT_ID=
WAVEPAY_API_KEY=
AYAPAY_MERCHANT_ID=
CBPAY_MERCHANT_ID=

# Firebase (Notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# App
NODE_ENV=development
API_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Monitoring
SENTRY_DSN=
POSTHOG_KEY=

# Payment Providers (Myanmar + adapter control)
# PAYMENTS_MODE=fake locally. Never fake in production.
PAYMENTS_MODE=fake
PAYMENTS_FAKE_SECRET=dev-fake-secret
PUBLIC_API_URL=http://localhost:3002
API_PORT=3002
TICKET_HMAC_SECRET=change-me-ticket-hmac-at-least-32-chars

KBZPAY_MERCHANT_ID=
KBZPAY_API_KEY=
KBZPAY_CHECKOUT_BASE=
WAVEPAY_MERCHANT_ID=
WAVEPAY_API_KEY=
WAVEPAY_ENDPOINT=https://testpayments.wavemoney.io:8107/payment
AYAPAY_MERCHANT_ID=
CBPAY_MERCHANT_ID=
DINGER_API_KEY=

