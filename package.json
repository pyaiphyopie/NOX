{
  "name": "nox-platform",
  "version": "0.1.0",
  "private": true,
  "description": "NOX — Urban Entertainment Infrastructure Platform. Own The Night.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset",
    "prepare": "husky"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "@types/node": "^22.10.2"
  },
  "workspaces": [
    "backend/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "tar@<7.5.21": "^7.5.21",
      "multer@<2.5.0": "^2.5.0",
      "body-parser@<1.20.9": "^1.20.9",
      "tmp@<0.2.6": "^0.2.6",
      "lodash@<4.18.0": "^4.18.0",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "glob@>=10.2.0 <10.5.0": "^10.5.0"
    }
  }
}
