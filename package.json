{
  "name": "nox-platform",
  "version": "0.1.0",
  "private": true,
  "description": "NOX — Urban Entertainment Infrastructure Platform. Own The Night.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset",
    "prepare": "husky"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "@types/node": "^22.10.2"
  },
  "workspaces": [
    "apps/*",
    "backend/*",
    "packages/*"
  ]
}
